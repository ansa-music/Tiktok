# URL проекта Supabase (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=
# Ключ service_role (Settings → API). Используется ТОЛЬКО на сервере, никогда не попадает в браузер
SUPABASE_SERVICE_ROLE_KEY=
# Пароль для входа в /admin
ADMIN_PASSWORD=
# Случайная строка минимум 32 символа для подписи cookie сессии (например: openssl rand -hex 32)
SESSION_SECRET=
# (необязательно) Публичный адрес сайта для sitemap и Open Graph, например https://studhelp.kz
NEXT_PUBLIC_SITE_URL=
